# Database — point this at Supabase Postgres (pgvector enabled). No Docker needed.
# Supabase: Project Settings > Database > Connection string (use the asyncpg form).
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# Redis + Qdrant are NOT used in Phase 1 — leave as-is / ignore.
REDIS_URL=redis://localhost:6379

# Vector Store
VECTOR_STORE_BACKEND=pgvector
QDRANT_URL=http://localhost:6333
VECTOR_STORE_API_KEY=

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# AI via n8n (chosen approach) — all model + embedding calls go through Bobby's
# n8n workflows, so credentials stay in n8n. Set the two webhook URLs below.
# When these are set, the direct SDK keys underneath are NOT used.
N8N_LLM_WEBHOOK_URL=https://n8n.example.com/webhook/answer-engine-llm
N8N_EMBEDDING_WEBHOOK_URL=https://n8n.example.com/webhook/answer-engine-embed
# Optional shared secret sent as a header on every webhook call.
N8N_WEBHOOK_AUTH_HEADER=X-Api-Key
N8N_WEBHOOK_AUTH_TOKEN=

# Direct SDK fallback — only used if the n8n webhook URLs above are left blank.
LLM_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-4-5-20251001
LLM_FALLBACK_MODEL=claude-haiku-4-5-20251001

# Auth
JWT_SECRET=changeme-use-a-strong-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Pipeline Config
RETRIEVAL_TOP_K=20
EVIDENCE_BUNDLE_SIZE=10
PIPELINE_TIMEOUT_SECONDS=60
MAX_MODEL_RETRIES=3

# Feature Flags
ENABLE_RERANKER=false
ENABLE_STREAMING=false

# Observability
LOG_LEVEL=INFO
SENTRY_DSN=

# CORS
ALLOWED_ORIGINS=["http://localhost:3000"]
