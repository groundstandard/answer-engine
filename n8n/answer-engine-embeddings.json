      "parameters": {
        "jsCode": "// The Answer Engine expects { \"embeddings\": [[...], [...]] } in the SAME order\n// as the input array. OpenAI returns { data: [ { index, embedding }, ... ] }.\n// Guard: if the OpenAI call returned no data, surface an error instead of an\n// empty 200 (an empty body silently degrades retrieval on the caller side).\nconst r = $json || {};\nconst data = Array.isArray(r.data) ? r.data.slice() : [];\nif (!data.length) { throw new Error('OpenAI returned no embedding data'); }\ndata.sort((a, b) => (a.index ?? 0) - (b.index ?? 0));\nreturn [{ json: { embeddings: data.map(d => d.embedding) } }];"
